# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/citizenready
# Set to require when connecting to Postgres over TLS (or use ?sslmode=require in DATABASE_URL)
# DATABASE_SSL=require

# Auth (JWT session cookie)
JWT_SECRET=generate-a-long-random-secret

# Site Configuration
# For local development, use http://localhost:3000
# For production, use your public site URL (e.g. https://citizenready.ca)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Email (Resend)
# RESEND_API_KEY=re_your_key_here

# Optional: Payments (Stripe)
# STRIPE_SECRET_KEY=sk_test_your_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_key_here

# Optional: Analytics (PostHog)
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Optional: Monitoring (Sentry)
# SENTRY_DSN=https://your_dsn@sentry.io/your_project_id

# Optional: AI blog draft (admin form → Claude → Postgres draft)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
